# Copy to apps/web/.env.local for local development. Never commit real secrets.
# This file contains NAMES and PLACEHOLDERS ONLY (plan.md §3).
# If a real secret is ever copied here, rotate it immediately.

# --- Supabase (B0+) ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# New-format publishable key (browser-visible; NOT the legacy anon JWT)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# New-format secret key (server-only; bypasses RLS — never NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# --- Application ---
APP_URL=http://localhost:3000
# Build-time public URL. Vercel Preview uses the staging URL/project; Vercel
# Production uses the production URL/project. Never put a secret in NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Runtime data adapter: demo | supabase (staging/production use supabase)
FASS_DATA_ADAPTER=demo
# Browser-visible mirror; must exactly match FASS_DATA_ADAPTER.
NEXT_PUBLIC_FASS_DATA_ADAPTER=demo
# Local `next dev` only. Production builds ignore these convenience settings.
FASS_DEV_AUTH_BYPASS=false
FASS_DEV_TEST_PASSWORD=
FASS_TOTP_REQUIRED=true
# DEMO ONLY: skips the staff authenticator step for a hosted walkthrough.
# Never set this on the production environment.
FASS_DEMO_NO_TOTP=
# DEMO ONLY: family sign-in with email+password (no OTP inbox needed).
# Never set this on the production environment.
FASS_DEMO_PASSWORD_SIGNIN=

# --- Resend (B6) ---
# RESEND_WEBHOOK_SECRET is the Resend dashboard signing secret verbatim,
# including its whsec_ prefix (the Svix verifier requires the prefix).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=

# --- Operations (B6) ---
CRON_SECRET=

# --- Document scanning (prefer DOCUMENT_SCANNER_PROVIDER; default manual) ---
# manual | http | clamav. Default manual keeps the callback-only pipeline.
#
# manual: no scan runs in the worker. An external scanner or operator reports
#   the result to POST /api/documents/<documentRef>/scan with
#   DOCUMENT_SCANNER_SECRET. Optionally DOCUMENT_SCANNER_URL is a local trigger
#   stub: the worker POSTs metadata only (bucket, objectKey, declaredMimeType,
#   sizeBytes, checksumSha256) and the stub reports the result through the same
#   callback. The document stays `pending_scan` until that callback arrives.
# http: the worker POSTs the stored bytes to DOCUMENT_SCANNER_URL with
#   `Authorization: Bearer DOCUMENT_SCANNER_SECRET` and metadata headers
#   (X-FASS-Document-*) and expects JSON
#   { "status": "ready" | "quarantined" | "failed", "detail"?: string }.
# clamav: the worker streams the stored bytes to clamd over TCP (INSTREAM).
#   OK -> ready, "<signature> FOUND" -> quarantined. A connection or protocol
#   failure stays transient and is retried by the outbox worker.
DOCUMENT_SCANNER_PROVIDER=manual
DOCUMENT_SCANNER_SECRET=
DOCUMENT_SCANNER_URL=
# clamav only: host is required for provider=clamav; port defaults to 3310.
DOCUMENT_SCANNER_CLAMAV_HOST=
DOCUMENT_SCANNER_CLAMAV_PORT=3310
# Optional provider timeout in milliseconds (clamped to 1000-120000; default 15000).
DOCUMENT_SCANNER_TIMEOUT_MS=

# --- Migrations / administrative scripts only; the runtime never uses these ---
DATABASE_URL=postgresql://localhost:5432/fass_dev
TEST_DATABASE_URL=postgresql://localhost:5432/fass_test

# --- Isolated facility demonstrator (frontend-only; receives no backend tables) ---
FASS_IOT_STAFF_SECRET=change-me-to-a-long-random-string-at-least-32-chars
FASS_IOT_STAFF_PASSWORD=change-me
FASS_IOT_DEV_AUTO_STAFF=1
FASS_IOT_RATE_LIMIT_PER_MIN=120
